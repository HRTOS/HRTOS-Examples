  76          /*------------------------------------------------
  77           * 数码管显示任务
  78           *
  79           * 显示：
  80           *
  81           * HHMM
  82           *
  83           * 例如：
  84           * 12:35 -> 1235
  85           * 08:06 -> 0806
  86           *------------------------------------------------*/
  87          void task_seg_display(void)
  88          {
  89   1          unsigned char hour;
  90   1          unsigned char minute;
  91   1      
  92   1          while(1)
  93   1          {
  94   2              /* BCD转换为十进制 */
  95   2              hour = bcd_to_dec(rtc_time[2]);
  96   2              minute = bcd_to_dec(rtc_time[1]);
  97   2      
  98   2              /* 显示小时 */
  99   2              drv_seg_display(0, hour / 10);
 100   2                      os_delay_ms(1);
 101   2              drv_seg_display(1, hour % 10);
 102   2                      os_delay_ms(1);
 103   2              /* 显示分钟 */
 104   2              drv_seg_display(2, (u16)minute / 10);
 105   2                      os_delay_ms(1);
 106   2              drv_seg_display(3, minute % 10);
 107   2                      os_delay_ms(1);
 108   2                      
 109   2                      
 110   2          }
 111   1      }
