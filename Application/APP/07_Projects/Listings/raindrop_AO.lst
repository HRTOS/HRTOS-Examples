  60           *------------------------------------------------*/
  61          void task_seg_display(void)
  62          {
  63   1          unsigned int value;
  64   1      
  65   1          while(1)
  66   1          {
  67   2              /* 获取当前ADC值 */
  68   2              value = raindrop_value;
  69   2      
  70   2              /*
  71   2               * 显示10位ADC结果
  72   2               *
