   5          /*------------------------------------------------
   6           * DHT11读取一个字节
   7           *
   8           * 注意：
   9           * 本函数必须在关闭总中断的情况下调用，
  10           * 保证数据位采样时序不被中断打断。
  11           *------------------------------------------------*/
  12          void drv_dht11_read_byte(unsigned char *_data)
  13          {
  14   1          unsigned char i;
  15   1          unsigned char flag;
  16   1          unsigned char temp;
  17   1          unsigned char value;
  18   1      
  19   1          value = 0;
  20   1      
  21   1          for(i = 0; i < 8; i++)
  22   1          {
  23   2              flag = 2;
  24   2                      
  25   2                      
  26   2                      
  27   2              /*
  28   2               * 等待数据线进入低电平
  29   2               */
  30   2              while((!DHT11_DATA) && flag++);
  31   2      
  32   2              /*
  33   2               * 延时后判断数据线状态
  34   2               * 高电平持续时间决定数据位为0还是1
  35   2               */
  36   2              drv_dht11_delay_10us();
  37   2              drv_dht11_delay_10us();
  38   2      
  39   2              temp = 0;
  40   2      
  41   2              if(DHT11_DATA)
  42   2              {
  43   3                  temp = 1;
  44   3              }
  45   2      
  46   2              flag = 2;
  47   2      
  48   2              /*
  49   2               * 等待当前数据位结束
  50   2               */
  51   2              while((DHT11_DATA) && flag++);
  52   2                      
  53   2                      if(flag==1)break;
