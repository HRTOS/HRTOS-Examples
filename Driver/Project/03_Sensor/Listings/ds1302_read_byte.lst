  48   1           *
  49   1           * DS1302低位优先传输。
  50   1           *------------------------------------------------*/
  51   1          for(i = 0; i < 8; i++)
  52   1          {
  53   2              DS1302_IO = (bit)(addr & 0x01);
C51 COMPILER V9.60.7.0   DS1302_READ_BYTE                                                  09/09/2026 12:50:08 PAGE 2   

  54   2      
  55   2              
  56   2      
