   3          /*------------------------------------------------
   4           * 获取超声波距离
   5           *
   6           * 返回：
   7           *     距离，单位mm
   8           *
   9           * 处理流程：
  10           *     1. 多次采样
  11           *     2. 数据排序
  12           *     3. 去除最大值和最小值
  13           *     4. 求平均值
  14           *     5. 根据计数值换算距离
  15           *------------------------------------------------*/
  16          unsigned int drv_ultrasonic_read(void)
  17          {
  18   1          unsigned char i;
  19   1      
  20   1          unsigned long sum;
  21   1      
  22   1          unsigned int average;
  23   1          unsigned int distance;
  24   1      
  25   1      
  26   1          /*--------------------------------------------
  27   1           * 多次采样
  28   1           *--------------------------------------------*/
  29   1              HRTOS_DRV_LOOP_0001:
  30   1          for(i = 0;
  31   1              i < DRV_ULTRASONIC_SAMPLE_MAX;
  32   1              )
  33   1          {
  34   2              ultrasonic_buffer[i] =
  35   2                  drv_ultrasonic_measure();
  36   2                      if(ultrasonic_buffer[i]!=0)
  37   2                              i++;
  38   2                      os_delay(1);
  39   2          }
  40   1      
  41   1      
  42   1          /*--------------------------------------------
  43   1           * 数据排序
