   1          #include "hrtos_hal.h"
   2          
   3          
   4          /*------------------------------------------------
   5           * 读取STC12C5A60S2内部ADC
   6           *
   7           * channel：
   8           * 0~7，对应P1.0~P1.7
   9           *
  10           * 返回：
  11           * 10位ADC转换结果
  12           * 0~1023
  13           *------------------------------------------------*/
  14          unsigned int drv_raindrop_read_ao(unsigned char channel)
  15          {
  16   1          unsigned int adc_value;
  17   1      
  18   1          /* 限制ADC通道范围 */
  19   1          channel &= 0x07;
  20   1      
  21   1          /*
  22   1           * 将对应P1引脚设置为ADC输入
  23   1           *
  24   1           * P1ASF：
  25   1           * bit0 -> P1.0
  26   1           * bit1 -> P1.1
  27   1           * ...
  28   1           * bit7 -> P1.7
  29   1           */
  30   1          P1ASF |= (1 << channel);
  31   1      
  32   1          /*
  33   1           * 启动ADC转换
  34   1           */
  35   1          ADC_CONTR =
  36   1              ADC_POWER |
  37   1              ADC_SPEED |
  38   1              ADC_START |
  39   1              channel;
  40   1      
  41   1          /*
  42   1           * 等待ADC转换完成
  43   1           */
  44   1          while(!(ADC_CONTR & ADC_FLAG))
  45   1          {
  46   2              ;
  47   2          }
  48   1      
  49   1          /*
  50   1           * 读取10位ADC结果
  51   1           *
  52   1           * ADC_RES：
  53   1           * 高8位
C51 COMPILER V9.60.7.0   RAINDROP_READ_AO                                                  09/06/2026 11:58:08 PAGE 2   

  54   1           *
  55   1           * ADC_LOW2：
  56   1           * 低2位
  57   1           */
  58   1          adc_value = ((unsigned int)ADC_RES << 2);
  59   1          adc_value |= (ADC_LOW2 & 0x03);
  60   1      
  61   1          /*
  62   1           * 清除ADC完成标志
  63   1           */
  64   1          ADC_CONTR &= ~ADC_FLAG;
  65   1      
  66   1          return adc_value;
  67   1      }


