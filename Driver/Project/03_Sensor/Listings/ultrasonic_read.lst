  51   1          sum = 0;
  52   1      
  53   1          for(i = DRV_ULTRASONIC_FILTER_COUNT;
C51 COMPILER V9.60.7.0   ULTRASONIC_READ                                                   09/09/2026 12:50:09 PAGE 2   

  54   1              i < DRV_ULTRASONIC_SAMPLE_MAX -
  55   1                  DRV_ULTRASONIC_FILTER_COUNT;
  56   1              i++)
  57   1          {
  58   2              sum += ultrasonic_buffer[i];
  59   2          }
  60   1      
  61   1      
  62   1          /*--------------------------------------------
  63   1           * 求平均值
