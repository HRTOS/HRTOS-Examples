  45   2               * 这里使用P1.0作为ADC输入。
  46   2               */
  47   2              raindrop_value =
  48   2                  drv_raindrop_read_ao(0);
  49   2      
  50   2              /*
  51   2               * 周期读取
  52   2               */
  53   2              os_delay(10);
  54   2          }
