   1          #include "hrtos_hal.h"
   2          
   3          /*******************************************************************************
   4           * 函 数 名 : eeprom_24c02_read
   5           * 功能描述 : 从 24C02 指定地址读取一个字节
   6           * 输    入 : addr - EEPROM 地址
   7           * 输    出 : 读取到的数据
   8           ******************************************************************************/
   9          unsigned char eeprom_24c02_read(unsigned char addr)
  10          {
  11   1          unsigned char dat;
  12   1      
  13   1          /* 写入待读取的 EEPROM 地址 */
  14   1          eeprom_i2c_start();
  15   1      
  16   1          eeprom_i2c_write_byte(0xA0);
  17   1          eeprom_i2c_write_byte(addr);
  18   1      
  19   1          /* 重启总线，切换到读操作 */
  20   1          eeprom_i2c_start();
  21   1      
  22   1          eeprom_i2c_write_byte(0xA1);
  23   1      
  24   1          dat = eeprom_i2c_read_byte();
  25   1      
  26   1          /* 主机发送 NACK，表示读取结束 */
  27   1          EEPROM_SDA = 1;
  28   1          eeprom_delay();
  29   1      
  30   1          EEPROM_SCL = 1;
  31   1          eeprom_delay();
  32   1      
  33   1          EEPROM_SCL = 0;
  34   1          eeprom_delay();
  35   1      
  36   1          eeprom_i2c_stop();
  37   1      
  38   1          return dat;
  39   1      }


