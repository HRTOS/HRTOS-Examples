   1          #include "hrtos_hal.h"
   2          
   3          
   4          /*------------------------------------------------
   5           * 读取温度
   6           *
   7           * 返回：
   8           * 温度值，单位为0.01℃
   9           *
  10           * 例如：
  11           * 25.25℃ -> 2525
  12           * -10.50℃ -> -1050
  13           *------------------------------------------------*/
  14          signed int drv_ds18b20_read(void)
  15          {
  16   1          /* 保存进入函数前的总中断状态 */
  17   1          unsigned char ea_state;
  18   1      
  19   1          /* DS18B20温度数据 */
  20   1          unsigned char low;
  21   1          unsigned char high;
  22   1      
  23   1          /* 合并后的16位原始温度数据 */
  24   1          unsigned int raw_data;
  25   1      
  26   1          /* 最终返回的温度值 */
  27   1          signed int value;
  28   1      
  29   1          /* 温度计算临时变量 */
  30   1          float temperature;
  31   1      
  32   1      
  33   1          /*------------------------------------------------
  34   1           * 关闭总中断
  35   1           *
  36   1           * DS18B20采用严格的单总线时序，
  37   1           * 防止中断打断数据通信。
  38   1           *------------------------------------------------*/
  39   1          ea_state = EA;
  40   1          EA = 0;
  41   1      
  42   1      
  43   1          /*------------------------------------------------
  44   1           * 发送复位信号
  45   1           *------------------------------------------------*/
  46   1          drv_ds18b20_reset();
  47   1      
  48   1      
  49   1          /*------------------------------------------------
  50   1           * 发送跳过ROM命令
  51   1           *
  52   1           * 0xCC：
  53   1           * Skip ROM，跳过ROM匹配。
C51 COMPILER V9.60.7.0   DS18B20_READ                                                      09/06/2026 11:58:06 PAGE 2   

  54   1           *
  55   1           * 当总线上只有一个DS18B20时，
  56   1           * 可以直接使用该命令。
  57   1           *------------------------------------------------*/
  58   1          drv_ds18b20_write_byte(0xCC);
  59   1      
  60   1      
  61   1          /*------------------------------------------------
  62   1           * 发送读取温度命令
  63   1           *
  64   1           * 0xBE：
  65   1           * Read Scratchpad，读取暂存器。
  66   1           *------------------------------------------------*/
  67   1          drv_ds18b20_write_byte(0xBE);
  68   1      
  69   1      
  70   1          /*------------------------------------------------
  71   1           * 读取温度数据
  72   1           *
  73   1           * DS18B20先发送低8位，
  74   1           * 再发送高8位。
  75   1           *------------------------------------------------*/
  76   1          low = drv_ds18b20_read_byte();
  77   1          high = drv_ds18b20_read_byte();
  78   1      
  79   1      
  80   1          /*------------------------------------------------
  81   1           * 恢复进入函数前的总中断状态
  82   1           *
  83   1           * 不直接使用EA = 1，
  84   1           * 避免调用函数前总中断本来就是关闭状态。
  85   1           *------------------------------------------------*/
  86   1          EA = ea_state;
  87   1      
  88   1      
  89   1          /*------------------------------------------------
  90   1           * 合并16位温度原始数据
  91   1           *
  92   1           * high：高8位
  93   1           * low ：低8位
  94   1           *
  95   1           * 最终：
  96   1           * raw_data = high << 8 | low
  97   1           *------------------------------------------------*/
  98   1          raw_data = high;
  99   1          raw_data <<= 8;
 100   1          raw_data |= low;
 101   1      
 102   1      
 103   1          /*------------------------------------------------
 104   1           * 将无符号原始数据转换为有符号温度数据
 105   1           *
 106   1           * DS18B20支持正负温度。
 107   1           *------------------------------------------------*/
 108   1          value = raw_data;
 109   1      
 110   1      
 111   1          /*------------------------------------------------
 112   1           * 转换为实际温度
 113   1           *
 114   1           * DS18B20默认12位分辨率，
 115   1           * 每个最低位代表0.0625℃。
C51 COMPILER V9.60.7.0   DS18B20_READ                                                      09/06/2026 11:58:06 PAGE 3   

 116   1           *------------------------------------------------*/
 117   1          temperature = value * 0.0625;
 118   1      
 119   1      
 120   1          /*------------------------------------------------
 121   1           * 转换为0.01℃单位
 122   1           *
 123   1           * 例如：
 124   1           * 25.36℃ -> 2536
 125   1           *
 126   1           * 加0.5或减0.5用于四舍五入。
 127   1           *------------------------------------------------*/
 128   1          value = temperature * 100 +
 129   1                  (value > 0 ? 0.5 : -0.5);
 130   1      
 131   1      
 132   1          /*------------------------------------------------
 133   1           * 返回温度值
 134   1           *------------------------------------------------*/
 135   1          return value;
 136   1      }


