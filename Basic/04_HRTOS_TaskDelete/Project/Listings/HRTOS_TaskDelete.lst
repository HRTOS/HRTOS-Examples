   1          #include "hrtos.h"
   2          
   3          /*==================== 配置 ====================*/
   4          #define TASK_TARGET   1
   5          #define TASK_TEST     2
   6          
   7          #define PRIO_TARGET   5
   8          #define PRIO_TEST     4
   9          
  10          #define STACK_TARGET  5
  11          #define STACK_TEST    5
  12          
  13          #define TICK_TARGET   20
  14          #define TICK_TEST     50
  15          
  16          /*==================== LED 定义 ====================*/
  17          sbit LED_TARGET = P1^0;   /* 目标任务运行指示灯 */
  18          sbit LED_TEST   = P1^1;   /* 删除结果指示灯 */
  19          
  20          /*==================== 全局 ====================*/
  21          static u8 delete_result = 0;
  22          
  23          /*==================== 目标任务 ====================*/
  24          static void target_task(void)
  25          {
  26   1          LED_TARGET = 1;   /* 初始灭灯 */
  27   1      
  28   1          while (1)
  29   1          {
  30   2              LED_TARGET = ~LED_TARGET;
  31   2      
  32   2              os_delay(TICK_TARGET);
  33   2          }
  34   1      }
  35          
  36          /*==================== 删除测试任务 ====================*/
  37          static void test_task(void)
  38          {
  39   1          LED_TEST = 1;   /* 初始灭灯 */
  40   1      
  41   1          while (1)
  42   1          {
  43   2              /*
  44   2               * 删除目标任务
  45   2               * HRTOS采用标记删除机制，
  46   2               * 最终由IDLE任务完成任务清理。
  47   2               */
  48   2              if (os_task_delete(TASK_TARGET) == 1)
  49   2              {
  50   3                  /*
  51   3                   * 主动延时，让出CPU，使IDLE获得运行机会，
  52   3                   * 完成目标任务的最终删除和资源释放。
  53   3                   */
  54   3                  os_delay(TICK_TEST);
C51 COMPILER V9.60.7.0   HRTOS_TASKDELETE                                                  08/20/2026 20:47:03 PAGE 2   

  55   3      
  56   3                  /*
  57   3                   * 删除完成后重新查询任务状态。
  58   3                   * 0 = 已删除
  59   3                   */
  60   3                  if (os_task_get_state(TASK_TARGET) == 0)
  61   3                  {
  62   4                      delete_result = 1;
