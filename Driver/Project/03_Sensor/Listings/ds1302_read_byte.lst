  12           * DS1302采用低位优先方式传输。
  13           *------------------------------------------------*/
  14          unsigned char drv_ds1302_read_byte(unsigned char addr)
  15          {
  16   1          unsigned char i;
  17   1          unsigned char _data;
  18   1          //unsigned char bit_data;
  19   1      
  20   1          unsigned char ea_state;
  21   1      
  22   1      
  23   1          _data = 0;
  24   1      
  25   1      
  26   1          /* 保存进入函数前的中断状态 */
  27   1          ea_state = EA;
  28   1      
  29   1          /* 关闭总中断，保护严格时序 */
  30   1          EA = 0;
  31   1      
  32   1      
  33   1          /*------------------------------------------------
  34   1           * 开始一次DS1302通信
  35   1           *------------------------------------------------*/
  36   1          DS1302_RST = 0;
  37   1          _nop_();
  38   1      
  39   1          DS1302_SCLK = 0;
  40   1          _nop_();
  41   1      
  42   1          DS1302_RST = 1;
