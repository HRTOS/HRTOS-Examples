   4          /*******************************************************************************
   5           * 函 数 名 : eeprom_i2c_write_byte
   6           * 功能描述 : I2C 发送一个字节
   7           * 输    入 : dat - 待发送数据
   8           * 输    出 : 1 - 收到应答
   9           *           0 - 未收到应答
  10           ******************************************************************************/
  11          unsigned char eeprom_i2c_write_byte(unsigned char dat)
  12          {
  13   1          unsigned char i;
  14   1          unsigned char timeout;
  15   1      
  16   1          for (i = 0; i < 8; i++)
  17   1          {
  18   2              EEPROM_SDA = dat & 0x80;
  19   2              dat <<= 1;
  20   2      
  21   2              eeprom_delay();
  22   2      
  23   2              EEPROM_SCL = 1;
  24   2              eeprom_delay();
  25   2      
  26   2              EEPROM_SCL = 0;
  27   2              eeprom_delay();
  28   2          }
  29   1      
  30   1          /* 释放 SDA，等待从机应答 */
  31   1          EEPROM_SDA = 1;
  32   1          eeprom_delay();
  33   1      
  34   1          EEPROM_SCL = 1;
  35   1          eeprom_delay();
  36   1      
  37   1          timeout = 0;
  38   1      
  39   1          while (EEPROM_SDA)
  40   1          {
  41   2              timeout++;
  42   2      
  43   2              if (timeout > 200)
  44   2              {
  45   3                  EEPROM_SCL = 0;
  46   3                  eeprom_delay();
  47   3      
  48   3                  return 0;
  49   3              }
  50   2          }
  51   1      
  52   1          EEPROM_SCL = 0;
  53   1          eeprom_delay();
