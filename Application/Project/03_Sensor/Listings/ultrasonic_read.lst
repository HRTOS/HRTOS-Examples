   1          #include "hrtos_hal.h"
   2          
   3          /*------------------------------------------------
   4           * 获取超声波距离
   5           *
   6           * 返回：
   7           *     距离，单位mm
   8           *
   9           * 处理流程：
  10           *     1. 多次采样
  11           *     2. 数据排序
  12           *     3. 去除最大值和最小值
  13           *     4. 求平均值
  14           *     5. 根据计数值换算距离
  15           *------------------------------------------------*/
  16          unsigned int drv_ultrasonic_read(void)
  17          {
  18   1          unsigned char i;
  19   1      
  20   1          unsigned long sum;
  21   1      
  22   1          unsigned int average;
  23   1          unsigned int distance;
  24   1      
  25   1      
  26   1          /*--------------------------------------------
  27   1           * 多次采样
  28   1           *--------------------------------------------*/
  29   1          for(i = 0;
  30   1              i < DRV_ULTRASONIC_SAMPLE_MAX;
  31   1              i++)
  32   1          {
  33   2              ultrasonic_buffer[i] =
  34   2                  drv_ultrasonic_measure();
  35   2          }
  36   1      
  37   1      
  38   1          /*--------------------------------------------
  39   1           * 数据排序
  40   1           *--------------------------------------------*/
  41   1          drv_ultrasonic_sort();
  42   1      
  43   1      
  44   1          /*--------------------------------------------
  45   1           * 去除最大值和最小值
  46   1           *--------------------------------------------*/
  47   1          sum = 0;
  48   1      
  49   1          for(i = DRV_ULTRASONIC_FILTER_COUNT;
  50   1              i < DRV_ULTRASONIC_SAMPLE_MAX -
  51   1                  DRV_ULTRASONIC_FILTER_COUNT;
  52   1              i++)
  53   1          {
C51 COMPILER V9.60.7.0   ULTRASONIC_READ                                                   09/06/2026 11:58:07 PAGE 2   

  54   2              sum += ultrasonic_buffer[i];
  55   2          }
  56   1      
  57   1      
  58   1          /*--------------------------------------------
  59   1           * 求平均值
  60   1           *--------------------------------------------*/
  61   1          average =
  62   1              (unsigned int)(
  63   1                  sum /
  64   1                  (DRV_ULTRASONIC_SAMPLE_MAX -
  65   1                   2 * DRV_ULTRASONIC_FILTER_COUNT)
  66   1              );
  67   1      
  68   1      
  69   1          /*--------------------------------------------
  70   1           * 根据Timer1计数值换算距离
  71   1           *
  72   1           * 11.0592MHz晶振：
  73   1           *
  74   1           * 传统12T 51：
  75   1           *     机器周期约为1.085us
  76   1           *
  77   1           * 超声波距离：
  78   1           *
  79   1           *     距离 = 时间 × 声速 / 2
  80   1           *
  81   1           * 这里按照原例程的实际换算系数，
  82   1           * 将Timer计数值转换为mm。
  83   1           *--------------------------------------------*/
  84   1          distance =
  85   1              (unsigned int)(average * 0.1953925);
  86   1      
  87   1      
  88   1          return distance;
  89   1      }
