line level    source

   1          #include "hrtos_hal.h"
   2          
   3          
   4          /*================================================
   5           * 函数：drv_soil_read_ao
   6           *
   7           * 功能：
   8           *      读取土壤湿度模拟量
   9           *
  10           * 返回：
  11           *      10位ADC转换结果
  12           *
  13           * 范围：
  14           *      0~1023
  15           *
  16           * 说明：
  17           *      AO连接P1.0，
  18           *      因此使用ADC通道0。
  19           *================================================*/
  20          unsigned int drv_soil_read_ao(void)
  21          {
  22   1          unsigned int value;
  23   1      
  24   1          /* 启动ADC转换 */
  25   1          ADC_CONTR = ADC_POWER |
  26   1                      ADC_SPEEDLL |
  27   1                      ADC_START |
  28   1                      0;
  29   1      
  30   1          /* 等待ADC转换完成 */
  31   1          while(!(ADC_CONTR & ADC_FLAG))
  32   1          {
  33   2              ;
  34   2          }
  35   1      
  36   1          /* 清除ADC完成标志 */
  37   1          ADC_CONTR &= ~ADC_FLAG;
  38   1      
  39   1          /* 获取10位ADC结果 */
  40   1          value = ((unsigned int)ADC_RES << 2);
  41   1          value |= (ADC_LOW2 & 0x03);
  42   1      
  43   1          return value;
  44   1      }


