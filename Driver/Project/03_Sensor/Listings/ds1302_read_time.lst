  14           *
  15           * 返回数据采用BCD格式。
  16           *------------------------------------------------*/
  17          void drv_ds1302_read_time(unsigned char *time)
  18          {
  19   1          unsigned char i;
  20   1          unsigned char ea_state;
  21   1      
  22   1      
  23   1          /* 保存当前中断状态 */
  24   1          ea_state = EA;
  25   1      
