   5          /*
   6           * =========================================================
   7           * DS1302 + 4位数码管时钟示例
   8           * ---------------------------------------------------------
   9           * 功能：
  10           * 1. 初始化DS1302
  11           * 2. 读取DS1302当前时间
  12           * 3. 使用4位数码管显示时、分
  13           * 4. 每秒更新一次时间
  14           *
  15           * 显示格式：
  16           *
  17           *       12:35
  18           *
  19           * DS1302时间数据采用BCD格式：
  20           *
  21           * time[0]：秒
  22           * time[1]：分
  23           * time[2]：时
  24           * time[3]：日
  25           * time[4]：月
  26           * time[5]：星期
  27           * time[6]：年
  28           * =========================================================
  29           */
  30          
  31          
  32          /*------------------------------------------------
  33           * DS1302时间数据
  34           *------------------------------------------------*/
  35          unsigned char rtc_time[7];
  36          
  37          //u8 sec;
  38          /*------------------------------------------------
  39           * BCD转十进制
  40           *
  41           * 例如：
  42           * 0x25 -> 25
  43           * 0x59 -> 59
  44           *------------------------------------------------*/
  45          unsigned char bcd_to_dec(unsigned char bcd)
  46          {
  47   1          return (bcd >> 4) * 10 + (bcd & 0x0F);
  48   1      }
  49          
  50          
  51          /*------------------------------------------------
  52           * DS1302读取任务
  53           *
  54           * 每秒读取一次DS1302时间
