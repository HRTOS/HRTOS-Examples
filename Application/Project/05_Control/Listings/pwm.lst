  91          /*
  92           * 函数名：drv_pwm_set_duty
  93           *
  94           * 功能：
  95           *      设置PWM占空比。
  96           *
  97           * 参数：
  98           *      duty：0~100
  99           *
 100           * 说明：
 101           *      PCA硬件PWM寄存器的方向与
 102           *      常规“数值越大占空比越大”的
 103           *      直觉相反。
 104           *
 105           *      因此这里将：
 106           *
 107           *          0   -> 0%
 108           *          100 -> 100%
 109           *
 110           *      转换成PCA对应的寄存器值。
 111           */
 112          void drv_pwm_set_duty(u8 duty)
 113          {
 114              unsigned int pwm_value;
C51 COMPILER V9.60.7.0   PWM                                                               08/16/2026 10:04:10 PAGE 3   

 115          
 116              /*
 117               * 限制参数范围
 118               */
 119              if(duty > 100)
 120              {
 121                  duty = 100;
 122              }
 123          
 124              pwm_duty = duty;
 125          
 126              /*
 127               * 将0~100%的占空比
 128               * 转换为0~255。
 129               */
 130              pwm_value = (unsigned int)duty * 255;
 131              pwm_value /= 100;
 132          
 133              /*
 134               * PCA PWM寄存器：
 135               *
 136               * 0x00 -> 接近100%
 137               * 0xFF -> 接近0%
 138               *
 139               * 因此需要反向转换。
 140               */
 141              pwm_value = 255 - pwm_value;
 142          
 143              CCAP0H = (u8)pwm_value;
 144              CCAP0L = (u8)pwm_value;
 145          }
