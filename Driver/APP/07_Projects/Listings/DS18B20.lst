  34          
  35          
  36          /*------------------------------------------------
  37           * DS18B20 温度读取任务
  38           *------------------------------------------------*/
  39          void task_ds18b20_read(void)
  40          {
  41   1          while(1)
  42   1          {
  43   2              /*
  44   2               * 启动 DS18B20 温度转换
  45   2               */
  46   2              drv_ds18b20_start();
  47   2      
  48   2              /*
  49   2               * DS18B20 使用 12 位分辨率时，
  50   2               * 温度转换最长需要约 750ms。
  51   2               *
  52   2               * HRTOS 的 os_delay() 参数单位为 10ms，
  53   2               * 因此这里延时 75 个时间单位，即 750ms。
  54   2               */
C51 COMPILER V9.60.7.0   DS18B20                                                           09/02/2026 22:10:20 PAGE 2   

  55   2              os_delay(75);
  56   2      
  57   2              /*
  58   2               * 读取温度转换结果。
  59   2               *
  60   2               * 返回值单位为 0.01℃。
  61   2               */
  62   2              ds18b20_temperature = drv_ds18b20_read();
  63   2      
  64   2              /*
  65   2               * 等待一段时间后进行下一次温度转换。
